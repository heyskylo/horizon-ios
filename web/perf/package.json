{
  "name": "horizon-perf-web",
  "version": "0.1.0",
  "private": true,
  "description": "The web UI for .hzperf captures (docs/perf-platform.md §7): reads them in the browser with the same wasm as horizon-perf",
  "scripts": {
    "wasm": "node scripts/copy-wasm.mjs",
    "dev": "node scripts/copy-wasm.mjs && next dev",
    "build": "node scripts/copy-wasm.mjs && next build",
    "start": "next start",
    "typecheck": "node scripts/copy-wasm.mjs && tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.0"
  }
}
