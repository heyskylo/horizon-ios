App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"SERVER_PORT":"{{$ServerPort}}","HORIZON_EULA":"{{HorizonEula}}","HORIZON_WORLD":"{{HorizonWorld}}","HORIZON_SEED":"{{HorizonSeed}}","HORIZON_WHITELIST":"{{HorizonWhitelist}}","HORIZON_PLAYERS":"{{HorizonPlayers}}","HORIZON_OP":"{{HorizonOp}}","HORIZON_ONLINE":"{{HorizonOnline}}"}
