    "horizon-client -> horizon-theme",
    "horizon-client-lib -> horizon-anticheat",
    "horizon-client-lib -> horizon-bench",
    "horizon-client-lib -> horizon-hdr",
    "horizon-client-lib -> horizon-mcp",
    "horizon-client-lib -> horizon-mods",
    "horizon-client-lib -> horizon-optifine",
    "horizon-client-lib -> horizon-shader-api",
    "horizon-client-lib -> horizon-shaders",
    "horizon-client-lib -> horizon-telemetry",
    "horizon-client-render -> horizon-cosmetics",
    "horizon-client-render -> horizon-hdr",
    "horizon-client-render -> horizon-optifine",
    "horizon-client-render -> horizon-polytone",
    "horizon-client-render -> horizon-shader-api",
    "horizon-client-render -> horizon-shaders"
  ]
