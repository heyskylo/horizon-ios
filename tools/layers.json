{
  "_doc": "docs/layers.md. Each crate's layer (engine, platform, horizon, or tool for dev tools) and the layers each may depend on: the Horizon layer uses only the platform, so it can build from its own repository. 'allowed' lists the exceptions left to move: entries only go away.",
  "may_depend": {
    "engine": ["engine"],
    "platform": ["engine", "platform"],
    "horizon": ["platform", "horizon"]
  },
  "workspaces": [
    "Cargo.toml",
    "launcher/Cargo.toml",
    "crates/horizon-telemetry-server/Cargo.toml",
    "crates/horizon-mod-registry/Cargo.toml"
  ],
  "crates": {
    "horizon-assets": "engine",
    "horizon-client": "engine",
    "horizon-client-core": "engine",
    "horizon-client-input": "engine",
    "horizon-client-lib": "engine",
    "horizon-client-render": "engine",
    "horizon-command": "engine",
    "horizon-core": "engine",
    "horizon-hooks": "engine",
    "horizon-items": "engine",
    "horizon-narrator": "engine",
    "horizon-prepare": "engine",
    "horizon-protocol": "engine",
    "horizon-server-files": "engine",
    "horizon-system": "engine",
    "horizon-threads": "engine",
    "horizon-world": "engine",

    "cargo-horizon-mod": "platform",
    "horizon-anticheat": "platform",
    "horizon-chat-filter": "platform",
    "horizon-dualsense": "platform",
    "horizon-game": "platform",
    "horizon-hdr": "platform",
    "horizon-mcp": "platform",
    "horizon-mod-api-gen": "platform",
    "horizon-mod-deps": "platform",
    "horizon-mods": "platform",
    "horizon-optifine": "platform",
    "horizon-platform": "platform",
    "horizon-polytone": "platform",
    "horizon-port-pack": "platform",
    "horizon-shader-api": "platform",
    "horizon-shaders": "platform",
    "horizon-theme": "platform",

    "horizon-addresses": "horizon",
    "horizon-bench": "horizon",
    "horizon-cosmetics": "horizon",
    "horizon-discord": "horizon",
    "horizon-friends": "horizon",
    "horizon-heartbeat": "horizon",
    "horizon-launcher": "horizon",
    "horizon-mod-registry": "horizon",
    "horizon-official": "horizon",
    "horizon-official-servers": "horizon",
    "horizon-relay": "horizon",
    "horizon-release-sign": "horizon",
    "horizon-server": "horizon",
    "horizon-telemetry": "horizon",
    "horizon-telemetry-server": "horizon",

    "horizon-bots": "tool",
    "horizon-mod-api-gen-tests": "tool",
    "xtask": "tool"
  },
  "portable": {
    "_doc": "docs/layers.md#engine: vanilla's rules and data with no desktop in them, which a port builds on. They depend only on each other, and never on a forbidden library.",
    "crates": [
      "horizon-assets",
      "horizon-client-core",
      "horizon-command",
      "horizon-core",
      "horizon-items",
      "horizon-protocol",
      "horizon-world"
    ],
    "forbidden": ["arboard", "cpal", "gilrs", "ureq", "wgpu", "winit"]
  },
  "allowed": [
    "horizon-client -> horizon-anticheat",
    "horizon-client -> horizon-bench",
    "horizon-client -> horizon-chat-filter",
    "horizon-client -> horizon-cosmetics",
    "horizon-client -> horizon-dualsense",
